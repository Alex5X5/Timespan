<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:vm="using:Hourglass.GUI.ViewModels.Pages"
			 xmlns:vc="using:Hourglass.GUI.ValueConverters"
			 xmlns:cls="using:Hourglass.GUI.Views.Pages"
			 xmlns:reactive="using:System.Reactive;assembly=System.Reactive"
			 x:Class="Hourglass.GUI.Views.Pages.TimerPageView"
			 x:DataType="vm:TimerPageViewModel"
			 x:CompileBindings="True"
			 Loaded="UserControl_Loaded"
			 Unloaded="UserControl_Unloaded">
	<Design.DataContext>
		<vm:TimerPageViewModel />
	</Design.DataContext>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="2*" />
			<RowDefinition Height="15*" />
			<RowDefinition Height="2*" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="3*" />
			<ColumnDefinition Width="6*" />
			<ColumnDefinition Width="3*" />
		</Grid.ColumnDefinitions>
		<Grid Grid.Row="1" Grid.Column="1" ShowGridLines="false">
			<Grid.RowDefinitions>
				<RowDefinition Height="6*" />
				<RowDefinition Height="3*" />
				<RowDefinition Height="3*" />
				<RowDefinition Height="3*" />
				<RowDefinition Height="1*" />
				<RowDefinition Height="12*" />
				<RowDefinition Height="1*" />
				<RowDefinition Height="3*" />
				<RowDefinition Height="1*" />
				<RowDefinition Height="3*" />
				<RowDefinition Height="7*" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="2*" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="2*" />
			</Grid.ColumnDefinitions>
			<TextBlock Text="{ Binding $parent[cls:TimerPageView].StartLabelText }"
					   Grid.Row="1"
					   Grid.Column="0"
					   Classes="Default DynamicTextHeight H2"/>
			<TextBox Text="{ Binding StartTextboxText }"
					 Grid.Row="2"
					 Grid.Column="0"
					 VerticalContentAlignment="Center"
					 Classes="Default Output Rounded DynamicTextHeight" />
			<TextBox Text="{ Binding FinishTextboxText }"
					 Grid.Row="2"
					 Grid.Column="2"
					 VerticalContentAlignment="Center"
					 Classes="Default Output Rounded DynamicTextHeight" />
			<TextBlock Text="{ Binding $parent[cls:TimerPageView].DescriptionLabelText }"
					   Grid.Row="4"
					   Grid.Column="0"
					   Classes="Default DynamicTextHeight" />
			<TextBox Text="{ Binding DescriptionTextboxText }"
					 Grid.Row="6"
					 Grid.Column="0"
					 Grid.ColumnSpan="3"
					 Name="DescriptionTextbox"
					 Classes="Default Rounded"
					 FontSize="{ Binding $self.Bounds, Converter={x:Static vc:TextSizeConverters.TextSizeFromWidthAndHeightAndParameterConverter}, ConverterParameter=0.26 }"
					 VerticalContentAlignment="Top"
					 GotFocus="TextBox_GotFocus"
					 KeyDown="TextBox_KeyDown"
					 TextWrapping="Wrap"/>
			<Grid Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="3" ColumnDefinitions="2*, 3*, 3*, 3*, 2*" >
				<Button Name="startButton"
						Grid.Column="1"
						Classes="Default"
						IsEnabled="{ Binding IsStartButtonEnabled }"
						Command="{ Binding StartTaskCommand }" >
					<Grid RowDefinitions="*, 5*, *" ColumnDefinitions="*, 10*, *">
						<Viewbox Grid.Row="1"
								 Grid.Column="1"
								 Stretch="Uniform"
								 VerticalAlignment="Center"
								 HorizontalAlignment="Center">
							<TextBlock Classes="ButtonContent"
									   Text="{ Binding $parent[cls:TimerPageView].StartButtonText }" />
						</Viewbox>
					</Grid>
				</Button>
				<Button Name="stopButton"
						Grid.Column="3"
						Classes="Default"
						IsEnabled="{ Binding IsStopButtonEnabled }"
						Command="{ Binding StopTaskCommand }" >
					<Grid RowDefinitions="*, 5*, *" ColumnDefinitions="*, 10*, *">
						<Viewbox Grid.Row="1"
								 Grid.Column="1"
								 Stretch="Uniform"
								 VerticalAlignment="Center"
								 HorizontalAlignment="Center">
							<TextBlock Classes="ButtonContent"
									   Text="{ Binding $parent[cls:TimerPageView].StopButtonText }" />
						</Viewbox>
					</Grid>
				</Button>
			</Grid>
		</Grid>
	</Grid>
</UserControl>
