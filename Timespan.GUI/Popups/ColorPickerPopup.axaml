<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		mc:Ignorable="d" d:DesignWidth="350" d:DesignHeight="400"
		xmlns:cls="using:Timespan.GUI.Popups"
		Title="ColorPickerPopup"
		Width="350"
		Height="400"
		x:Class="Timespan.GUI.Popups.ColorPickerPopup">

	<Window.Styles>
		<StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Simple/Simple.xaml" />
	</Window.Styles>
	<ColorView Grid.Row="1"
			   Grid.Column="1"
			   IsVisible="True"
			   Color="{Binding $parent[cls:ColorPickerPopup].Color , Mode=TwoWay}"
			   HorizontalAlignment="Stretch"
			   VerticalAlignment="Stretch"/>
</Window>
