<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:cls="using:Timespan.GUI.Views"
			 xmlns:views="using:Timespan.GUI.Views"
			 xmlns:models="using:Timespan.GUI.ViewModels"
			 xmlns:graphViews="using:Timespan.GUI.Views.Graphs"
			 xmlns:graphModels="using:Timespan.GUI.ViewModels.Graphs"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:DataType="models:GraphsViewModel"
             x:Class="Timespan.GUI.Views.GraphsView"
			 Loaded="UserControl_Loaded">
	
	<UserControl.Styles>
		<StyleInclude Source="avares://Timespan.GUI/Styles/Views/GraphsView.styles.axaml" />
	</UserControl.Styles>
  
	<UserControl.DataTemplates>
        <DataTemplate DataType="graphModels:DayPanelViewModel">
            <graphViews:DayPanelView MarkedColumns="{ Binding MarkedColumns }"
								BlockedColumns="{ Binding BlockedColumns }"
								Tasks="{ Binding Tasks }"
								XAxisSegmentCount="{ Binding XAxisSegmentCount }"
								IntervalStartSeconds="{ Binding TimeIntervallStartSeconds }"
								IntervalStopSeconds="{ Binding TimeIntervallStopSeconds }"
								MousePressedCommand="{ Binding MousePressedCommand }"
								MouseDraggingCommand="{ Binding MouseDraggingCommand }"
								ClickedCommand="{ Binding ClickedCommand }"
								TaskClickedCommand="{ Binding TaskClickedCommand }"
								LoadCommand="{ Binding LoadCommand }"/>
        </DataTemplate>
        <DataTemplate DataType="graphModels:WeekPanelViewModel">
            <graphViews:WeekPanelView MarkedColumns="{ Binding MarkedColumns }"
								 BlockedColumns="{ Binding BlockedColumns }"	
								 Tasks="{ Binding Tasks }"
								 XAxisSegmentCount="{ Binding XAxisSegmentCount }"
								 IntervalStartSeconds="{ Binding TimeIntervallStartSeconds }"
								 IntervalStopSeconds="{ Binding TimeIntervallStopSeconds }"
								 MousePressedCommand="{ Binding MousePressedCommand }"
								 MouseDraggingCommand="{ Binding MouseDraggingCommand }"
								 ClickedCommand="{ Binding ClickedCommand }"
								 TaskClickedCommand="{ Binding TaskClickedCommand }"
								 LoadCommand="{ Binding LoadCommand }"/>
        </DataTemplate>
        <DataTemplate DataType="graphModels:MonthPanelViewModel">
            <graphViews:MonthPanelView MarkedColumns="{ Binding MarkedColumns }"
								  BlockedColumns="{ Binding BlockedColumns }"
								  Tasks="{ Binding Tasks }"
								  XAxisSegmentCount="{ Binding XAxisSegmentCount }"
								  IntervalStartSeconds="{ Binding TimeIntervallStartSeconds }"
								  IntervalStopSeconds="{ Binding TimeIntervallStopSeconds }"
								  MousePressedCommand="{ Binding MousePressedCommand }"
								  MouseDraggingCommand="{ Binding MouseDraggingCommand }"
								  ClickedCommand="{ Binding ClickedCommand }"
								  TaskClickedCommand="{ Binding TaskClickedCommand }"
								  LoadCommand="{ Binding LoadCommand }"/>
        </DataTemplate>
    </UserControl.DataTemplates>

	
	<Grid ShowGridLines="False">
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="61*" />
			<ColumnDefinition Width="{ Binding SpacerWidth }" />
			<ColumnDefinition Width="{ Binding TaskPanelWidth }" />
			<!--
			<ColumnDefinition Width="2*" />
			<ColumnDefinition Width="24*" />
			-->
		</Grid.ColumnDefinitions>
		
		<Grid ShowGridLines="False">
			<Grid.RowDefinitions>
				<RowDefinition Height="6*" />
				<RowDefinition Height="8*" />
				<RowDefinition Height="3*" />
				<RowDefinition Height="76*" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="24*" />
			</Grid.ColumnDefinitions>

			<!--task bar-->
			<Grid Grid.Row="1"
				  ShowGridLines="False">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="12*" />
					<ColumnDefinition Width="1*" />
					<ColumnDefinition Width="5*" />
					<ColumnDefinition Width="1*" />
					<ColumnDefinition Width="16*" />
					<ColumnDefinition Width="1*" />
					<ColumnDefinition Width="9*" />
					<ColumnDefinition Width="1*" />
					<ColumnDefinition Width="9*" />
					<ColumnDefinition Width="5*" />
					<ColumnDefinition Width="10*" />
				</Grid.ColumnDefinitions>

				<TextBlock Text="{ Binding $parent[cls:GraphsView].TitleLabelText }"
						   Classes="h2" />
			
				<Grid Grid.Column="4"
					  RowDefinitions="9*, 18*, 9*"
					  ColumnDefinitions="15*, 4*, 4*"
					  ShowGridLines="False">
					<TextBlock Grid.Row="1"
							   Grid.Column="0"
							   Text="{ Binding DateString }"
							   Classes="p1"
							   TextAlignment="Right" />
					<Button Grid.Row="1"
							Grid.Column="1"
							Classes="OnlyClick"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Stretch">
						<Svg HorizontalAlignment="Stretch"
							 VerticalAlignment="Stretch"
							 Path="avares://Timespan.GUI/Assets/Images/pfeil-link.svg" />
					</Button>
					<Button Grid.Row="1"
							Grid.Column="2"
							Classes="OnlyClick"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Stretch">
						<Svg HorizontalAlignment="Stretch"
							 VerticalAlignment="Stretch"
							 Path="avares://Timespan.GUI/Assets/Images/pfeil-rechts.svg" />
					</Button>
				</Grid>

				<Button	Grid.Column="6"
						HorizontalAlignment="Stretch"
						VerticalAlignment="Stretch"
						Padding="0,0,0,0"
						Background="{ Binding $parent.Background }"
						Command="{ Binding SelectCommand }">
					<Grid RowDefinitions="*, 2*, 6*, 2*, *"
						  ColumnDefinitions="2*, 8*, *, 18*, 2*"
						  ShowGridLines="False">
						<TextBlock Grid.Row="2"
								   Grid.Column="3"
								   Text="{ Binding $parent[cls:GraphsView].SelectButtonText }"
								   Classes="p1" />
						<Viewbox Grid.Row="2"
								 Grid.Column="1"
								 Stretch="Uniform">
							<Svg Path="avares://Timespan.GUI/Assets/Images/haken-kreis.svg" />
						</Viewbox>
					</Grid>
				</Button>

				<Button	Grid.Column="8"
						HorizontalAlignment="Stretch"
						VerticalAlignment="Stretch"
						Padding="0,0,0,0"
						Background="{ Binding $parent.Background }"
						Command="{ Binding DeleteCommand }">
					<Grid RowDefinitions="*, 2*, 6*, 2*, *"
						  ColumnDefinitions="2*, 8*, *, 18*, 2*"
						  ShowGridLines="False">
						<TextBlock Grid.Row="2"
								   Grid.Column="3"
								   Text="{ Binding $parent[cls:GraphsView].DeleteButtonText }"
								   Classes="p1" />
						<Viewbox Grid.Row="2"
								 Grid.Column="1"
								 Stretch="Uniform">
							<Svg Path="avares://Timespan.GUI/Assets/Images/loeschen.svg" />
						</Viewbox>
					</Grid>
				</Button>
				<Grid Grid.Column="10"
					  RowDefinitions="*, 8*, *"
					  ShowGridLines="False">
					<ComboBox Grid.Row="1"
							  Classes="Default p1"
							  CornerRadius="17, 17, 17, 0"
							  ItemsSource="{ Binding TimeModes }"
							  SelectedItem="{ Binding SelectedTimeMode }">
					</ComboBox>
				</Grid>
			</Grid>
			<ContentControl Grid.Row="3"
							Grid.Column="1"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Stretch"
							Content="{ Binding CurrentPage }"/>
		</Grid>
		<!--task details panel-->
		<Grid Grid.Row="0"
			  Grid.Column="2"
			  Grid.ColumnSpan="1"
			  IsVisible="{ Binding ShowTaskPanel }">
			<Grid.RowDefinitions>
				<RowDefinition Height="17*" />
				<RowDefinition Height="76*" />
			</Grid.RowDefinitions>
			<Rectangle Fill="#D9D9D9"
					   Grid.Row="1"
					   HorizontalAlignment="Stretch"
					   VerticalAlignment="Stretch"
					   RadiusX="20"
					   RadiusY="20"/>
			<Grid Grid.Row="1"
				  ShowGridLines="False">
				<Grid.RowDefinitions>
					<RowDefinition Height="2*" />
					<RowDefinition Height="4*" />
					<RowDefinition Height="3*" />
					<RowDefinition Height="4*" />
					<RowDefinition Height="3*" />
					<RowDefinition Height="20*" />
					<RowDefinition Height="40*" />
					<RowDefinition Height="2*" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="3*" />
					<ColumnDefinition Width="50*" />
					<ColumnDefinition Width="3*" />
				</Grid.ColumnDefinitions>
				<Grid Grid.Row="1"
					  Grid.Column="1"
					  ShowGridLines="False">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="26*" />
						<ColumnDefinition Width="6*" />
						<ColumnDefinition Width="4*" />
						<ColumnDefinition Width="6*" />
						<ColumnDefinition Width="4*" />
						<ColumnDefinition Width="6*" />
						<ColumnDefinition Width="6*" />
						<ColumnDefinition Width="6*" />
					</Grid.ColumnDefinitions>
					<Button Grid.Column="3"
							Classes="OnlyClick"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Command="{ Binding DeleteTaskCommand }">
						<Viewbox Stretch="Uniform">
							<Svg Path="avares://Timespan.GUI/Assets/Images/loeschen.svg" />
						</Viewbox>
					</Button>
					<Button Grid.Column="5"
							Classes="OnlyClick"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Command="{ Binding EditTaskCommand }">
						<Viewbox Stretch="Uniform">
							<Svg Path="avares://Timespan.GUI/Assets/Images/stift.svg" />
						</Viewbox>
					</Button>
					<Button Grid.Column="7"
							Classes="OnlyClick"
							HorizontalAlignment="Center"
							VerticalAlignment="Center"
							Command="{ Binding HideTaskCommand }">
						<Viewbox Stretch="Uniform">
							<Svg Path="avares://Timespan.GUI/Assets/Images/kreuz.svg" />
						</Viewbox>
					</Button>
				</Grid>
				<TextBlock Grid.Row="3"
						   Grid.Column="1"
						   HorizontalAlignment="Stretch"
						   VerticalAlignment="Stretch"
						   Classes="Default DynamicTextHeight"
						   Text="{ Binding ShowingTaskDateString }"/>
				<TextBlock Grid.Row="5"
						   Grid.Column="1"
						   Classes="Default"
						   HorizontalAlignment="Stretch"
						   VerticalAlignment="Stretch"
						   TextWrapping="Wrap"
						   Text="{ Binding ShowingTaskDescription }"/>
			</Grid>
		</Grid>
	</Grid>
</UserControl>
