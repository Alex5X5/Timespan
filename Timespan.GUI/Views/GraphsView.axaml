<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:cls="using:Timespan.GUI.Views"
			 xmlns:views="using:Timespan.GUI.Views"
			 xmlns:models="using:Timespan.GUI.ViewModels"
			 xmlns:graphViews="using:Timespan.GUI.Views.Graphs"
			 xmlns:graphModels="using:Timespan.GUI.ViewModels.Graphs"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:DataType="models:GraphsViewModel"
             x:Class="Timespan.GUI.Views.GraphsView"
			 Loaded="UserControl_Loaded">
  
	<UserControl.DataTemplates>
        <DataTemplate DataType="graphModels:DayViewModel">
            <graphViews:DayView />
        </DataTemplate>
        <DataTemplate DataType="graphModels:WeekViewModel">
            <graphViews:WeekView />
        </DataTemplate>
        <DataTemplate DataType="graphModels:MonthViewModel">
            <graphViews:MonthView />
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid ShowGridLines="True">
		<Grid.RowDefinitions>
			<RowDefinition Height="6*" />
			<RowDefinition Height="8*" />
			<RowDefinition Height="3*" />
			<RowDefinition Height="76*" />
			<RowDefinition Height="3*" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="24*" />
		</Grid.ColumnDefinitions>

		<Grid Grid.Row="1"
			  ShowGridLines="False">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="12*" />
				<ColumnDefinition Width="1*" />
				<ColumnDefinition Width="6*" />
				<ColumnDefinition Width="1*" />
				<ColumnDefinition Width="12*" />
				<ColumnDefinition Width="2*" />
				<ColumnDefinition Width="9*" />
				<ColumnDefinition Width="1*" />
				<ColumnDefinition Width="9*" />
				<ColumnDefinition Width="8*" />
				<ColumnDefinition Width="10*" />
			</Grid.ColumnDefinitions>

			<TextBlock Text="{ Binding $parent[cls:GraphsView].TitleLabelText }"
					   Classes="h2" />
			
			<TextBlock Grid.Column="4"
					   Text="{ Binding $parent[cls:GraphsView].TitleLabelText }"
					   Padding="0,0,0,0"
					   Classes="DynamicTextHeight" />

			<Button	Grid.Column="6"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Stretch"
					Padding="0,0,0,0"
					Background="{ Binding $parent.Background }">
				<Grid RowDefinitions="*, 2*, 6*, 2*, *"
					  ColumnDefinitions="*, 4*, *, 9*, *"
					  ShowGridLines="False">
					<TextBlock Grid.Row="2"
							   Grid.Column="3"
							   Text="{ Binding $parent[cls:GraphsView].SelectButtonText }"
							   Padding="0,0,0,0"
							   Classes="DynamicTextHeight" />
				</Grid>
			</Button>

			<Button	Grid.Column="8"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Stretch"
					Padding="0,0,0,0"
					Background="{ Binding $parent.Background }">
				<Grid RowDefinitions="*, 2*, 6*, 2*, *"
					  ColumnDefinitions="*, 4*, *, 9*, *"
					  ShowGridLines="False">
					<TextBlock Grid.Row="2"
							   Grid.Column="3"
							   Text="{ Binding $parent[cls:GraphsView].DeleteButtonText }"
							   Padding="0,0,0,0"
							   Classes="DynamicTextHeight" />
				</Grid>
			</Button>

			<ComboBox Grid.Column="10"
					  Classes="Default"
					  ItemsSource="{ Binding Items }"
					  SelectedItem="{ Binding SelectedItem }">

			</ComboBox>
		</Grid>
		<ContentControl Grid.Row="3"
					    Grid.Column="1"
					    Grid.ColumnSpan="1"
						Content="{ Binding CurrentPage }"/>
	</Grid>
</UserControl>
