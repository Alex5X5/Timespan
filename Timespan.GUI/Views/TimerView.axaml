<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:cls="using:Timespan.GUI.Views"
			 xmlns:views="using:Timespan.GUI.Views"
			 xmlns:models="using:Timespan.GUI.ViewModels"
			 xmlns:controls="using:Timespan.GUI.Controls"
			 xmlns:ext="using:Timespan.GUI.MarkupExtensions"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:DataType="models:TimerViewModel"
             x:Class="Timespan.GUI.Views.TimerView"
			 Loaded="UserControl_Loaded"
			 Unloaded="UserControl_Unloaded">
	<Grid ShowGridLines="False">
		<Grid.RowDefinitions>
			<RowDefinition Height="2*" />
			<RowDefinition Height="15*" />
			<RowDefinition Height="2*" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="2*" />
			<ColumnDefinition Width="3*" />
			<ColumnDefinition Width="2*" />
		</Grid.ColumnDefinitions>
		<Grid Grid.Row="1" Grid.Column="1" ShowGridLines="false">
			<Grid.RowDefinitions>
				<RowDefinition Height="2*" />
				<RowDefinition Height="3*" />
				<RowDefinition Height="3*" />
				<RowDefinition Height="3*" />
				<RowDefinition Height="1*" />
				<RowDefinition Height="12*" />
				<RowDefinition Height="1*" />
				<RowDefinition Height="2*" />
				<RowDefinition Height="1*" />
				<RowDefinition Height="3*" />
				<RowDefinition Height="2*" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="13*" />
				<ColumnDefinition Width="4*" />
				<ColumnDefinition Width="13*" />
			</Grid.ColumnDefinitions>
			<TextBox Classes="Default DynamicTextHeight" 
					 Grid.Row="3"
					 Grid.Column="0"
					 VerticalContentAlignment="Center"
					 CornerRadius="5,5,5,5"
					 PlaceholderText="{ Binding $parent[cls:TimerView].StartLabelText }"
					 Text="{ Binding StartTextboxText }"/>
			<TextBox Classes="Default DynamicTextHeight" 
					 Grid.Row="3"
					 Grid.Column="2"
					 VerticalContentAlignment="Center"
					 CornerRadius="5,5,5,5"
					 PlaceholderText="{ Binding $parent[cls:TimerView].FinishLabelText }"
					 Text="{ Binding FinishTextboxText }"/>
			<TextBlock Text="{ Binding $parent[cls:TimerView].TitleLabelText }"
					   Grid.Row="1"
					   Grid.Column="0"
					   Classes="h2" />
			<TextBox Grid.Row="5"
					 Grid.Column="0"
					 Grid.ColumnSpan="3"
					 Name="DescriptionTextbox"
					 Classes="Default"
					 VerticalContentAlignment="Top"
					 TextWrapping="Wrap"
					 CornerRadius="5,5,5,5"
					 PlaceholderText="{ Binding $parent[cls:TimerView].DescriptionLabelText }"
					 Text="{ Binding DescriptionTextboxText }"/>
			<controls:ColorSelectorControl Grid.Row="7"
										   Grid.Column="0"
										   Grid.ColumnSpan="3"
										   HorizontalAlignment="Stretch"
										   VerticalAlignment="Stretch"
										   ColorChangedCommand="{Binding ColorSelectedCommand}"
											   SelectedTask="{Binding SelectedTask}"/>
			<Grid Grid.Row="9" 
				  Grid.Column="0"
				  Grid.ColumnSpan="3"
				  ColumnDefinitions="3*, 1*, 3*, 6*"
				  ShowGridLines="false">
				<Button Name="startButton"
						Grid.Column="0"
						HorizontalAlignment="Stretch"
						VerticalAlignment="Stretch"
						Background="{ StaticResource ResourceKey=StartButtonColor }"
						Classes="DynamicBackground ThreeRounded DynamicTextHeight"
						IsEnabled="{ Binding IsStartButtonEnabled }"
						Command="{ Binding StartTaskCommand}">
					<TextBlock Text="{ Binding $parent[cls:TimerView].StartButtonText }" />
				</Button>
				<Button Name="stopButton"
						Grid.Column="2"
						HorizontalAlignment="Stretch"
						VerticalAlignment="Stretch"
						Background="{ StaticResource ResourceKey=StopButtonColor }"
						Classes="DynamicBackground ThreeRounded DynamicTextHeight"
						IsEnabled="{ Binding IsStopButtonEnabled }"
						Command="{ Binding StopTaskCommand }" >
					<TextBlock Text="{ Binding $parent[cls:TimerView].StopButtonText }" />
				</Button>
			</Grid>
		</Grid>
	</Grid>
</UserControl>
