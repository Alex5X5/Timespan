<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:views="using:Timespan.GUI.Views"
			 xmlns:models="using:Timespan.GUI.ViewModels"
			 xmlns:settingsViews="using:Timespan.GUI.Views.Settings"
			 xmlns:settingsModels="using:Timespan.GUI.ViewModels.Settings"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:CompileBindings="True"
			 x:DataType="models:SettingsViewModel"
			 x:Class="Timespan.GUI.Views.SettingsView"
			 Loaded="UserControl_Loaded">


	<UserControl.DataTemplates>
		<DataTemplate DataType="settingsModels:GeneralSettingsViewModel">
			<settingsViews:GeneralSettingsView />
		</DataTemplate>
		<DataTemplate DataType="settingsModels:UserDataSettingsViewModel">
			<settingsViews:UserDataSettingsView />
		</DataTemplate>
		<DataTemplate DataType="settingsModels:AboutSettingsViewModel">
			<settingsViews:AboutSettingsView />
		</DataTemplate>
		<DataTemplate DataType="settingsModels:GraphicsSettingsViewModel">
			<settingsViews:GraphicsSettingsView />
		</DataTemplate>
		<DataTemplate DataType="settingsModels:ExportSettingsViewModel">
			<settingsViews:ExportSettingsView />
		</DataTemplate>
	</UserControl.DataTemplates>

	<Grid>
		<ContentControl Grid.Row="2"
					    Grid.Column="1"
					    Grid.ColumnSpan="1"
						Background="white"
						Content="{ Binding CurrentPage }"/>
	</Grid>
</UserControl>
