<ResourceDictionary xmlns="https://github.com/avaloniaui"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<ResourceDictionary.MergedDictionaries>
		<ResourceInclude Source="/Styles/Themes/SrhCommon.axaml"/>
	</ResourceDictionary.MergedDictionaries>

	<Color x:Key="BackgroundColor1">#D9D9D9</Color >
	<Color x:Key="BackgroundColor1Light1">#E2E2E2</Color >
	<Color x:Key="BackgroundColor1Light2">#E9E9E9</Color >
	<Color x:Key="BackgroundColor1Dark1">#C5C5C5</Color >
	<Color x:Key="BackgroundColor1Dark2">#A1A1A1</Color >
	<Color x:Key="BackgroundColor2">#DF4807</Color >

	<Color x:Key="ButtonColor1">#DF4807</Color >
	<Color x:Key="ButtonColor2">#D9D9D9</Color >

	<Color x:Key="Foreground">#000000</Color >
	<Color x:Key="ForegroundLight">#101010</Color >
	
	
	<Color x:Key="HeaderBarBackgroundColor">#DF4807</Color >

	<Color x:Key="NavigationBarBackground">#1D1D1B</Color >

	<Color x:Key="NavigationButtonHover">#2C2C29</Color >
	<Color x:Key="NavigationButtonPressed">#363633</Color >
	<Color x:Key="NavigationButtonSelected">#FAFAFA</Color >
	<Color x:Key="NavigationButtonSelectedHover">#F0F0F0</Color >
	<Color x:Key="NavigationButtonSelectedPressed">#E0E0E0</Color >

	<Color x:Key="TextBoxBackground">#FAFAFA</Color >
	<Color x:Key="TextBoxBackgroundHover">#F0F0F0</Color >
	<Color x:Key="TextBoxBackgroundPressed">#E0E0E0</Color >
	<Color x:Key="TextBoxBorder">#D9D9D9</Color >
	<Color x:Key="TextBoxBorderHover">#CFCFCF</Color >
	<Color x:Key="TextBoxBorderPressed">#BFBFBF</Color >

	<Color x:Key="StartButtonColor">#D94807</Color >
	<Color x:Key="StopButtonColor">#DFD9D9</Color >
</ResourceDictionary>