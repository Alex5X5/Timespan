<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:vc="using:Timespan.GUI.Converters">
	<Thickness  x:Key="DefaultBorderThickness"> 2 </Thickness >
	<Thickness  x:Key="HoverBorderThickness"> 3 </Thickness >
	<Thickness  x:Key="ClickBorderThickness"> 3 </Thickness >
	<vc:ButtonCornerConverter x:Key="CornerConverter"/>
	<vc:ThreeRoundedButtonCornerConverter x:Key="ThreeCornerConverter"/>
	<vc:CircleButtonCornerConverter x:Key="CircleCornerConverter"/>
</ResourceDictionary>
