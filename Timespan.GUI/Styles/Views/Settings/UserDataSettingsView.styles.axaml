<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vc="using:Timespan.GUI.Converters">
	
	<Style Selector="TextBox.Input">
		<Setter Property="FontSize" Value="{ Binding $self.Bounds, Converter={ x:Static vc:TextSizeConverters.TextSizeFromWidthAndHeightAndParameterConverter }, ConverterParameter=1 }" />
		<Setter Property="Foreground" Value="Black" />
		<Setter Property="Padding" Value="10,0,0,0" />
		<Setter Property="CornerRadius" Value="5" />
		<Setter Property="HorizontalContentAlignment" Value="Left" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
	</Style>

</Styles>
