<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vc="using:Timespan.GUI.Converters">
	<Style Selector="Button.Navigation">
		<Setter Property="BorderBrush" Value="Transparent" />
		<Setter Property="Background" Value="{ DynamicResource NavigationBar }" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="VerticalAlignment" Value="Stretch" />
		<Setter Property="Padding" Value="0,0,0,0" />
		<Setter Property="Margin" Value="10,0" />
		<Setter Property="CornerRadius" Value="10" />
		<Setter Property="RenderTransformOrigin" Value="50%, 50%"/>
		
		<Style Selector ="^ TextBlock">
			<Setter Property="Foreground" Value="White" />
			<Setter Property="FontSize" Value="{ Binding $parent[Button].Bounds, Converter={x:Static vc:TextSizeConverters.TextSizeFromWidthAndHeightAndParameterConverter}, ConverterParameter=1.05 }" />
			<Setter Property="HorizontalAlignment" Value="Center" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>
		
		<Style Selector="^:pointerover /template/ ContentPresenter">
			<Setter Property="Background" Value="{ DynamicResource NavigationButtonHover }" />
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="RenderTransform" Value="None"/>
		</Style>
		
		<Style Selector="^:pressed /template/ ContentPresenter">
			<Setter Property="Background" Value="{ DynamicResource NavigationButtonPressed }" />
			<Setter Property="RenderTransform" Value="matrix(0.95,0.0,0.0,0.95,0,0) "/>
		</Style>
		
		<Style Selector="^.Selected">
			<Setter Property="Background" Value="{ DynamicResource NavigationButtonSelected }" />
			
			<Style Selector ="^ TextBlock">
				<Setter Property="Foreground" Value="Black" />
			</Style>

			<Style Selector="^:pointerover /template/ ContentPresenter">
				<Setter Property="Background" Value="{ DynamicResource NavigationButtonPressed }" />
			</Style>
			
			<Style Selector="^:pointerover /template/ ContentPresenter">
				<Setter Property="Background" Value="{ DynamicResource NavigationButtonSelectedHover }" />
			</Style>

			<Style Selector="^:pressed /template/ ContentPresenter">
				<Setter Property="Background" Value="{ DynamicResource NavigationButtonSelectedPressed }" />
			</Style>
		</Style>
	</Style>
</Styles>
