<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Timespan.GUI.Controls.ColorPickerButton"
             xmlns:cls="using:Timespan.GUI.Controls">

    <UserControl.Resources>
        <SolidColorBrush x:Key="SelectedBrush" Color="{Binding SelectedColor, RelativeSource={RelativeSource AncestorType=cls:ColorPickerButton}}" />
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

        <!-- Trigger button -->
        <Button x:Name="PART_PickerButton"
                Click="OnPickerButtonClick"
                Padding="10,6"
                CornerRadius="6">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <!-- Color swatch preview -->
                <Border x:Name="PART_Swatch"
                        Width="20" Height="20"
                        CornerRadius="4"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                        Background="{StaticResource SelectedBrush}" />
                <TextBlock Text="Pick Color"
                           VerticalAlignment="Center"
                           FontSize="13" />
            </StackPanel>
        </Button>

        <!-- Selected color hex label -->
        <TextBlock x:Name="PART_HexLabel"
                   VerticalAlignment="Center"
                   FontSize="12"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                   FontFamily="Consolas, Menlo, monospace" />

        <!-- Popup containing the ColorPicker -->
               <!---
               PlacementMode="Bottom"
               -->
        <Popup x:Name="PART_Popup"
               PlacementTarget="{Binding #PART_PickerButton}"
               IsLightDismissEnabled="True"
               WindowManagerAddShadowHint="True">

            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumLowBrush}"
                    BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12"
                    BoxShadow="0 4 16 0 #33000000">

                <StackPanel Spacing="10">

                    <!-- ColorPicker from Avalonia.Controls.ColorPicker -->
                    <ColorPicker x:Name="PART_ColorPicker"
                                 ColorChanged="OnColorChanged"
                                 HorizontalAlignment="Stretch" />

                    <!-- Action row -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8">
                        <Button Content="Cancel"
                                Click="OnCancelClick"
                                Padding="12,6" />
                        <Button Content="Select"
                                Click="OnSelectClick"
                                Padding="12,6"
                                Classes="accent" />
                    </StackPanel>

                </StackPanel>
            </Border>
        </Popup>

    </StackPanel>
</UserControl>