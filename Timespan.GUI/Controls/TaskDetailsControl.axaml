<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:cls="using:Timespan.GUI.Controls"
			 xmlns:views="using:Timespan.GUI.Views"
			 xmlns:models="using:Timespan.GUI.ViewModels"
			 xmlns:settingsViews="using:Timespan.GUI.Views.Settings"
			 xmlns:settingsModels="using:Timespan.GUI.ViewModels.Settings"
			 xmlns:vc="using:Timespan.GUI.Converters"
			 mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="450"
			 x:CompileBindings="True"
			 x:Class="Timespan.GUI.Controls.TaskDetailsControl">
	<UserControl.Styles>
		<StyleInclude Source="avares://Timespan.GUI/Styles/Views/TaskDetailsControl.styles.axaml" />
	</UserControl.Styles>

	<Panel>
		<!--Background-->
		<Rectangle Fill="#D9D9D9"
				   Grid.Row="1"
				   HorizontalAlignment="Stretch"
				   VerticalAlignment="Stretch"
				   RadiusX="20"
				   RadiusY="20"/>
		<!--Main Container-->
		<Grid Grid.Row="0"
			  Grid.Column="0"
			  ShowGridLines="False">
			<Grid.RowDefinitions>
				<RowDefinition Height="2*" />
				<RowDefinition Height="4*" />
				<RowDefinition Height="1*" />
				<RowDefinition Height="60*" />
				<RowDefinition Height="2*" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="3*"/>
				<ColumnDefinition Width="50*"/>
				<ColumnDefinition Width="3*"/>
			</Grid.ColumnDefinitions>
			<!--Header Container-->
			<Grid Grid.Row="1"
				  Grid.Column="1"
				  ShowGridLines="False">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="26*" />
					<ColumnDefinition Width="6*" />
					<ColumnDefinition Width="4*" />
					<ColumnDefinition Width="6*" />
					<ColumnDefinition Width="4*" />
					<ColumnDefinition Width="6*" />
					<ColumnDefinition Width="6*" />
					<ColumnDefinition Width="6*" />
				</Grid.ColumnDefinitions>
				<Button Grid.Column="3"
						Classes="OnlyClick"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						IsVisible="{Binding $parent[cls:TaskDetailsControl].ShowReadonlyTaskPanel}"
						Click="DeleteButtonClick">
					<Viewbox Stretch="Uniform">
						<Svg Path="avares://Timespan.GUI/Assets/Images/loeschen.svg" />
					</Viewbox>
				</Button>
				<Button Grid.Column="5"
						Classes="OnlyClick"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						IsVisible="{Binding $parent[cls:TaskDetailsControl].ShowReadonlyTaskPanel}"
						Click="EditButtonClick">
					<Viewbox Stretch="Uniform">
						<Svg Path="avares://Timespan.GUI/Assets/Images/stift.svg" />
					</Viewbox>
				</Button>
				<Button Grid.Column="5"
						Classes="OnlyClick"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						IsVisible="{Binding $parent[cls:TaskDetailsControl].ShowEditTaskPanel}"
						Click="SaveButtonClick">
					<Viewbox Stretch="Uniform">
						<Svg Path="avares://Timespan.GUI/Assets/Images/haken.svg" />
					</Viewbox>
				</Button>
				<Button Grid.Column="7"
						Classes="OnlyClick"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Click="CloseButtonClick">
					<Viewbox Stretch="Uniform">
						<Svg Path="avares://Timespan.GUI/Assets/Images/kreuz.svg" />
					</Viewbox>
				</Button>
			</Grid>
			<!--Readonly TextBoxes Container-->
			<Grid Grid.Row="3"
				  Grid.Column="1"
				  ShowGridLines="False"
				  IsVisible="{Binding $parent[cls:TaskDetailsControl].ShowReadonlyTaskPanel}">
				<Grid.RowDefinitions>
					<RowDefinition Height="12*" />
					<RowDefinition Height="3*" />
					<RowDefinition Height="7*" />
					<RowDefinition Height="6*" />
					<RowDefinition Height="60*" />
					<RowDefinition Height="72*" />
					<RowDefinition Height="6*" />
				</Grid.RowDefinitions>
				<TextBlock Name="TitleTextBlock"
						   Grid.Row="0"
						   Grid.Column="0"
						   Classes="p1"
						   HorizontalAlignment="Stretch"
						   VerticalAlignment="Stretch"
						   Text="{Binding $parent[cls:TaskDetailsControl].Title}"/>
				<Grid Grid.Row="2"
					  ColumnDefinitions="8* * 8* 2*">
					<TextBlock Name="DateTextBlock"
							   Grid.Column="0"
							   Classes="p3"
							   IsVisible="{Binding $parent[cls:TaskDetailsControl].ShowReadonlyTaskPanel}"
							   Text="{Binding $parent[cls:TaskDetailsControl].DateString}"/>
					<TextBlock Name="TimeTextBlock"
							   Grid.Column="2"
							   Classes="p3"
							   IsVisible="{Binding $parent[cls:TaskDetailsControl].ShowReadonlyTaskPanel}"
							   Text="{Binding $parent[cls:TaskDetailsControl].TimeString}"/>
				</Grid>
				<TextBlock Name="DescriptionTextBlock"
						   Grid.Row="4"
						   Grid.Column="1"
						   Classes="p2_1"
						   TextWrapping="Wrap"
						   IsVisible="{Binding $parent[cls:TaskDetailsControl].ShowReadonlyTaskPanel}"
						   Text="{Binding $parent[cls:TaskDetailsControl].Description}"/>
			</Grid>
			<!--Edit TextBoxes Container-->
			<Grid Grid.Row="3"
				  Grid.Column="1"
				  ShowGridLines="False"
				  IsVisible="{Binding $parent[cls:TaskDetailsControl].ShowEditTaskPanel}">
				<Grid.RowDefinitions>
					<RowDefinition Height="1*" />
					<RowDefinition Height="2*" />
					<RowDefinition Height="1*" />
					<RowDefinition Height="12*" />
					<RowDefinition Height="2*" />
					<RowDefinition Height="2*" />
					<RowDefinition Height="2*" />
					<RowDefinition Height="12*" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="13*" />
					<ColumnDefinition Width="4*" />
					<ColumnDefinition Width="13*" />
				</Grid.ColumnDefinitions>
				<TextBox Classes="Default DynamicTextHeight" 
							Grid.Row="1"
							Grid.Column="0"
							VerticalContentAlignment="Center"
							CornerRadius="5,5,5,5"
							Text="{ Binding $parent[cls:TaskDetailsControl].StartTextboxText }"/>
				<TextBox Classes="Default DynamicTextHeight" 
							Grid.Row="1"
							Grid.Column="2"
							VerticalContentAlignment="Center"
							CornerRadius="5,5,5,5"
							Text="{ Binding $parent[cls:TaskDetailsControl].FinishTextboxText }"/>
				<TextBox Grid.Row="3"
							Grid.Column="0"
							Grid.ColumnSpan="3"
							Classes="Default"
							VerticalContentAlignment="Top"
							TextWrapping="Wrap"
							CornerRadius="5,5,5,5"
							Text="{ Binding $parent[cls:TaskDetailsControl].DescriptionTextboxText }"/>
				<Grid Grid.Row="5"
						Grid.Column="0"
						Grid.ColumnSpan="3"
						ShowGridLines="True" >
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="10*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="10*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="10*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="10*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="10*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="10*" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="10*" />
						<ColumnDefinition Width="30*" />
					</Grid.ColumnDefinitions>
					<Viewbox Grid.Column="0" Stretch="Uniform">
						<Button Classes="Default DynamicBackground Circle"
								Width="100"
								Height="100"
								Background="{ StaticResource ResourceKey=TaskBackgroundRed }" />
					</Viewbox>
					<Viewbox Grid.Column="2" Stretch="Uniform">
						<Button Classes="Default DynamicBackground Circle"
								Width="100"
								Height="100"
								Background="{ StaticResource ResourceKey=TaskBackgroundOrange }" />
					</Viewbox>
					<Viewbox Grid.Column="4" Stretch="Uniform">
						<Button Classes="Default DynamicBackground Circle"
								Width="100"
								Height="100"
								Background="{ StaticResource ResourceKey=TaskBackgroundYellow }" />
					</Viewbox>
					<Viewbox Grid.Column="6" Stretch="Uniform">
						<Button Classes="Default DynamicBackground Circle"
								Width="100"
								Height="100"
								Background="{ StaticResource ResourceKey=TaskBackgroundDarkGreen }" />
					</Viewbox>
					<Viewbox Grid.Column="8" Stretch="Uniform">
						<Button Classes="Default DynamicBackground Circle"
								Width="100"
								Height="100"
								Background="{ StaticResource ResourceKey=TaskBackgroundDarkBlue }" />
					</Viewbox>
					<Viewbox Grid.Column="10" Stretch="Uniform">
						<Button Classes="Default DynamicBackground Circle"
								Width="100"
								Height="100"
								Background="{ StaticResource ResourceKey=TaskBackgroundDarkPurple }" />
					</Viewbox>
					<Viewbox Grid.Column="12" Stretch="Uniform">
						<Button Classes="Default DynamicBackground Circle"
								Width="100"
								Height="100"
								Background="{ StaticResource ResourceKey=TaskBackgroundRed }" />
					</Viewbox>
				</Grid>
			</Grid>
		</Grid>
	</Panel>
</UserControl>
