<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:cls="using:Timespan.GUI.Controls"
			 xmlns:views="using:Timespan.GUI.Views"
			 xmlns:models="using:Timespan.GUI.ViewModels"
			 xmlns:settingsViews="using:Timespan.GUI.Views.Settings"
			 xmlns:settingsModels="using:Timespan.GUI.ViewModels.Settings"
			 xmlns:vc="using:Timespan.GUI.Converters"
			 mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="450"
			 x:CompileBindings="True"
			 x:Class="Timespan.GUI.Controls.TaskDetailsControl">
	<Panel>
		<Rectangle Fill="#D9D9D9"
					Grid.Row="1"
					HorizontalAlignment="Stretch"
					VerticalAlignment="Stretch"
					RadiusX="20"
					RadiusY="20"/>
		<Grid Grid.Row="1"
			  ShowGridLines="False">
			<Grid.RowDefinitions>
				<RowDefinition Height="2*" />
				<RowDefinition Height="4*" />
				<RowDefinition Height="3*" />
				<RowDefinition Height="4*" />
				<RowDefinition Height="3*" />
				<RowDefinition Height="2.5*" />
				<RowDefinition Height="3*" />
				<RowDefinition Height="20*" />
				<RowDefinition Height="36*" />
				<RowDefinition Height="2*" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="3*" />
				<ColumnDefinition Width="50*" />
				<ColumnDefinition Width="3*" />
			</Grid.ColumnDefinitions>
			<Grid Grid.Row="1"
					Grid.Column="1"
					ShowGridLines="False">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="26*" />
					<ColumnDefinition Width="6*" />
					<ColumnDefinition Width="4*" />
					<ColumnDefinition Width="6*" />
					<ColumnDefinition Width="4*" />
					<ColumnDefinition Width="6*" />
					<ColumnDefinition Width="6*" />
					<ColumnDefinition Width="6*" />
				</Grid.ColumnDefinitions>
				<Button Grid.Column="3"
						Classes="OnlyClick"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						IsVisible="{Binding $parent[cls:TaskDetailsControl].ShowReadonlyTaskPanel}"
						Click="DeleteButtonClick">
					<Viewbox Stretch="Uniform">
						<Svg Path="avares://Timespan.GUI/Assets/Images/loeschen.svg" />
					</Viewbox>
				</Button>
				<Button Grid.Column="5"
						Classes="OnlyClick"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						IsVisible="{Binding $parent[cls:TaskDetailsControl].ShowReadonlyTaskPanel}"
						Click="EditButtonClick">
					<Viewbox Stretch="Uniform">
						<Svg Path="avares://Timespan.GUI/Assets/Images/stift.svg" />
					</Viewbox>
				</Button>
				<Button Grid.Column="5"
						Classes="OnlyClick"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						IsVisible="{Binding $parent[cls:TaskDetailsControl].ShowEditTaskPanel}"
						Click="EditButtonClick">
					<Viewbox Stretch="Uniform">
						<Svg Path="avares://Timespan.GUI/Assets/Images/haken.svg" />
					</Viewbox>
				</Button>
				<Button Grid.Column="7"
						Classes="OnlyClick"
						HorizontalAlignment="Center"
						VerticalAlignment="Center"
						Click="CloseButtonClick">
					<Viewbox Stretch="Uniform">
						<Svg Path="avares://Timespan.GUI/Assets/Images/kreuz.svg" />
					</Viewbox>
				</Button>
			</Grid>
			<TextBlock Name="TitleTextBlock"
					   Grid.Row="3"
					   Grid.Column="1"
					   HorizontalAlignment="Stretch"
					   VerticalAlignment="Stretch"
					   Classes="Default DynamicTextHeight"
					   Text="{Binding $parent[cls:TaskDetailsControl].Title}"/>
			<Grid Grid.Row="5"
				  Grid.Column="1"
				  ColumnDefinitions="8* * 8* 2*">
				<TextBlock Name="DateTextBlock"
						   Grid.Column="0"
						   HorizontalAlignment="Stretch"
						   VerticalAlignment="Stretch"
						   Classes="Default DynamicTextHeight"
						   Text="{Binding $parent[cls:TaskDetailsControl].DateString}"/>
				<TextBlock Name="TimeTextBlock"
						   Grid.Column="2"
						   HorizontalAlignment="Stretch"
						   VerticalAlignment="Stretch"
						   Classes="Default DynamicTextHeight"
						   Text="{Binding $parent[cls:TaskDetailsControl].TimeString}"/>
			</Grid>
			<TextBlock Name="DescriptionTextBlock"
					   Grid.Row="7"
					   Grid.Column="1"
					   Classes="Default"
					   HorizontalAlignment="Stretch"
					   VerticalAlignment="Stretch"
					   TextWrapping="Wrap"
					   Text="{Binding $parent[cls:TaskDetailsControl].Description}"/>
		</Grid>
	</Panel>
</UserControl>
