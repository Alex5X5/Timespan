<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:locator="using:Timespan.GUI"
             x:Class="Timespan.GUI.App"
             RequestedThemeVariant="Light">

	<Application.DataTemplates>
		<locator:ViewLocator/>
	</Application.DataTemplates>

	<Application.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceInclude Source="Styles/Resources/GlobalConverters.axaml"/>
				<ResourceInclude Source="Styles/Themes/SrhTheme.axaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Application.Resources>

	<Application.Styles>
		<FluentTheme />
		<StyleInclude Source="Styles/TextContainers.axaml" />
		<StyleInclude Source="Styles/Buttons.axaml" />
	</Application.Styles>
</Application>
